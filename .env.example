# ModelSwapBench environment variables (all optional).
# Copy to .env only if you use hosted or self-hosted endpoints. Never commit .env.
#
# Hosted providers are DISABLED by default. Keys are read by name from the
# environment and are never written to results or reports.

# Ollama endpoint (default: http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434

# Example API keys for hosted/self-hosted endpoints (only if you opt in):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
